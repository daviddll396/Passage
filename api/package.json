{
  "name": "passage-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && node --env-file=../.env --import tsx --watch src/server.ts",
    "db:migrate": "node --env-file=../.env --import tsx src/migrate.ts",
    "build": "tsc --noEmit false --rootDir src --outDir dist",
    "start": "node dist/server.js",
    "eval:budget:offline": "node --import tsx src/evaluate-budget-prompt.ts",
    "eval:budget:live": "node --env-file=../.env --import tsx src/evaluate-budget-live.ts",
    "test": "npm run db:migrate && node --env-file=../.env --import tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.1.0",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
